#!/usr/bin/env bash
#MISE description="Tag origin/main as v<VERSION> and push it, which is what publishes a release"
set -euo pipefail

# Tag what's on GitHub, not this checkout: local main can be stale or dirty.
git fetch -q origin main
version=$(git show origin/main:VERSION | tr -d '[:space:]')
if ! printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "VERSION on origin/main is not a bare semver: '$version'" >&2
  exit 1
fi

tag="v$version"
if git ls-remote --exit-code --tags https://github.com/NorthIsUp/TSMux.git "refs/tags/$tag" >/dev/null; then
  echo "$tag already exists — bump VERSION first (mise run bump-patch)" >&2
  exit 1
fi

git tag -a "$tag" -m "$tag" origin/main
git push https://github.com/NorthIsUp/TSMux.git "$tag"
echo "pushed $tag at $(git rev-parse --short origin/main) — the release workflow builds and publishes it"

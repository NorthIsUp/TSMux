#!/usr/bin/env bash
#MISE description="Tag origin/main as v<VERSION> and push it, which is what publishes a release"
set -euo pipefail

# Tag what's on GitHub, not this checkout: local main can be stale or dirty.
repo=https://github.com/NorthIsUp/TSMux.git
git fetch -q "$repo" main
rev=$(git rev-parse FETCH_HEAD)
version=$(git show "$rev:VERSION" | tr -d '[:space:]')
if ! printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "VERSION on origin/main is not a bare semver: '$version'" >&2
  exit 1
fi

tag="v$version"
if git ls-remote --exit-code --tags "$repo" "refs/tags/$tag" >/dev/null; then
  echo "$tag already exists — bump VERSION first (mise run bump-patch)" >&2
  exit 1
fi

git tag -a "$tag" -m "$tag" "$rev"
git push "$repo" "$tag"
echo "pushed $tag at ${rev:0:7} — the release workflow builds and publishes it"
